#!/bin/sh
# Blocks a commit that contains anything key-shaped.
# One-time setup:  brew install gitleaks && git config core.hooksPath .githooks

# 1. The Odds API key itself must never be staged, anywhere.
if [ -f .env ]; then
  key=$(sed -n 's/^ODDS_API_KEY=//p' .env | tr -d "\"' \r")
  if [ -n "$key" ] && git diff --cached | grep -qF -- "$key"; then
    echo "BLOCKED: the staged changes contain your Odds API key. Unstage that file." >&2
    exit 1
  fi
fi

# 2. Local-only files stay local.
if git diff --cached --name-only | grep -qE '(^|/)\.env$|^_private/|\.docx$'; then
  echo "BLOCKED: .env, _private/ and .docx files must not be committed." >&2
  exit 1
fi

# 3. gitleaks scans the staged changes for any other secret.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "BLOCKED: gitleaks is not installed. Run: brew install gitleaks" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner 2>/dev/null \
  || gitleaks protect --staged --redact --no-banner
